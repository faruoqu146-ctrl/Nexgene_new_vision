+def _as_utc(dt: datetime) -> datetime:
+    """Normalize DB-returned datetimes so naive values are treated as UTC."""
+    if dt is None:
+        return dt
+    if dt.tzinfo is None:
+        return dt.replace(tzinfo=timezone.utc)
+    return dt
+
